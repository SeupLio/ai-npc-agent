# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ---- 测试与缓存 ----
.pytest_cache/
# pytest 的 --basetemp：**每次跑给一个新目录**，别复用 ——
# 复用一个被前几轮污染过的 basetemp 会触发 pytest 内部的
# `assert not self._finalizers`，看起来像"我的测试坏了"。
.pytest_tmp/
.pytest_bt_*/
.pytest_out.txt
.coverage
htmlcov/

# ---- 运行产物 ----
reports/
*.log

# ---- Node（只给 scripts/mineflayer_bridge.js 用）----
node_modules/
# package.json / package-lock.json **要入库** —— 它们声明了桥的依赖版本，
# 是复现端到端测试的一部分。只有 node_modules 是产物。

# ---- Minecraft 服务端（端到端测试用，体积大，不入库）----
.mcserver/
world/
server.jar
eula.txt

# ---- 编辑器 ----
.vscode/
.idea/
.DS_Store
